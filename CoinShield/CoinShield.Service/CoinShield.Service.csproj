<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Support x64 (primary) for Windows Server 2022/2025 and GCP VM (n2, c3, t2d) -->
    <Platforms>x64;x86;ARM64</Platforms>
    <AssemblyName>CoinShield.Service</AssemblyName>
    <RootNamespace>CoinShield.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Default RID for local build; CI/GCP publish overrides with -r win-x64 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
    <!-- Suppress Windows-only APIs warning: we gate all Windows calls at runtime -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Windows Server Core has no desktop subsystem — ensure no WinForms dependency sneaks in -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0+server2022</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting"                  Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices"  Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog"         Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json"       Version="10.0.0" />
    <!-- HTTP client for GCP metadata server queries (lightweight, no extra deps) -->
    <PackageReference Include="Microsoft.Extensions.Http"                     Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CoinShield.Core\CoinShield.Core.csproj" />
    <ProjectReference Include="..\CoinShield.Configuration\CoinShield.Configuration.csproj" />
    <ProjectReference Include="..\CoinShield.Logging\CoinShield.Logging.csproj" />
    <ProjectReference Include="..\CoinShield.Models\CoinShield.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Config files copied to output — required at runtime -->
    <Content Include="..\CoinShield.Configuration\config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>config.json</Link>
    </Content>
    <Content Include="..\CoinShield.Configuration\allowlist.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>allowlist.json</Link>
    </Content>
    <!-- Task #1 FIX: mining-domains.json was missing from output -->
    <Content Include="..\CoinShield.Configuration\mining-domains.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>mining-domains.json</Link>
    </Content>
  </ItemGroup>
  <!-- Application manifest for Windows Server UAC and execution level -->
  <ItemGroup>
    <None Update="app.manifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
</Project>
